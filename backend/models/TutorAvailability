const mongoose = require('mongoose');

const tutorAvailabilitySchema = new mongoose.Schema({
  tutor: {
    type: mongoose.Schema.Types.ObjectId,
    ref: 'User',
    required: true
  },
  day: String,
  startTime: String,
  endTime: String
});

module.exports = mongoose.model('TutorAvailability', tutorAvailabilitySchema);